{
  "name": "node-webvtt",
  "version": "2.0.0",
  "description": "WebVTT parser, compiler, and segmenter with HLS support",
  "main": "index.js",
  "types": "types.d.ts",
  "scripts": {
    "eslint": "eslint *.js **/*.js",
    "test": "npm run eslint -s && nyc mocha -R dot"
  },
  "keywords": [
    "webvtt",
    "vtt",
    "segment",
    "hls",
    "subtitle",
    "closed",
    "caption"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/osk/node-webvtt"
  },
  "author": "Ólafur Sverrir Kjartansson <kjarni@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "chai": "^4.5.0",
    "eslint": "^7.32.0",
    "mocha": "^8.4.0",
    "nyc": "^18.0.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "files": [
    "/lib",
    "index.js"
  ],
  "nyc": {
    "extension": [
      ".js"
    ],
    "include": [
      "lib/**/*.js"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true,
    "check-coverage": true,
    "statements": 100,
    "functions": 100,
    "branches": 100,
    "lines": 100
  }
}
